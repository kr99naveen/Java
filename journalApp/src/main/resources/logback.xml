<!--configuration file to have our logs configuration. This will overwrite the-->
<!--default configurations of logback provided by springboot-->

<configuration>
    <appender name="myConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
<!--                pattern in which logs will be printed in console-->
                %d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

